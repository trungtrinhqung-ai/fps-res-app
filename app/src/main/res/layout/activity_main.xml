<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS RES"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Shizuku: đang kiểm tra..."
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/packageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Package game"
            android:inputType="text"/>

        <EditText
            android:id="@+id/downscale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Độ phân giải: 0.80 = 80%"
            android:inputType="numberDecimal"
            android:text="0.80"/>

        <Spinner
            android:id="@+id/fps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="ÁP DỤNG PROFILE"/>

        <Button
            android:id="@+id/performance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERFORMANCE"/>

        <Button
            android:id="@+id/reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STANDARD"/>

        <Button
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HIỆN OVERLAY"/>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Log..."
            android:textIsSelectable="true"/>

    </LinearLayout>

</ScrollView><?xml version="1.0" encoding="utf-8"?>

